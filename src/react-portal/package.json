{
  "name": "oi-portal-react",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild index.jsx --bundle --format=iife --global-name=__OI_REACT__ --minify --loader:.js=jsx --define:process.env.NODE_ENV='\"production\"' --outfile=../../build/widgets/oi-portal-app/react-bundle.js",
    "build:dev": "esbuild index.jsx --bundle --format=iife --global-name=__OI_REACT__ --loader:.js=jsx --define:process.env.NODE_ENV='\"development\"' --sourcemap --outfile=../../build/widgets/oi-portal-app/react-bundle.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
